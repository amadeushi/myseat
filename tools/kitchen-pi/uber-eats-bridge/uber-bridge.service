[Unit]
Description=Uber Eats bridge (printer for the Uber Eats tablet, receipts to mySeat)
After=network-online.target
Wants=network-online.target

[Service]
User=hamun
ExecStart=/usr/bin/python3 /usr/local/lib/uber-bridge/bridge.py
Restart=always
RestartSec=3
# only this service may open port 80 (the web server of the printer's card that the app asks first); no other rights, nothing is written but the spool folder
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/spool/uber-bridge

[Install]
WantedBy=multi-user.target
